---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'หิวข้าว — สุ่มร้านอาหารลาดกระบัง',
	description = 'คิดไม่ออกว่าจะกินอะไร? สุ่มร้านอาหารรอบพระจอมเกล้าลาดกระบัง (สจล.) เกกี หัวตะเข้ และถนนลาดกระบัง',
} = Astro.props;
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#e8590c" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600;700&family=Mitr:wght@500;600&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #fff8f1;
		--surface: #ffffff;
		--surface-2: #fff0e3;
		--text: #2b1d14;
		--muted: #7a6455;
		--line: #f0dccb;
		--accent: #e8590c;
		--accent-strong: #c2410c;
		--accent-soft: #ffe3cc;
		--good: #2f9e44;
		--shadow: 0 10px 30px -12px rgb(120 60 20 / 0.25);
		--radius: 18px;
		color-scheme: light;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #17110d;
			--surface: #221912;
			--surface-2: #2c2018;
			--text: #f7ebe0;
			--muted: #b59d8b;
			--line: #3b2c21;
			--accent: #ff8a3d;
			--accent-strong: #ffa366;
			--accent-soft: #3d2415;
			--good: #69db7c;
			--shadow: 0 10px 30px -12px rgb(0 0 0 / 0.6);
			color-scheme: dark;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: 'Anuphan', system-ui, sans-serif;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}

	button,
	input,
	select {
		font: inherit;
		color: inherit;
	}

	a {
		color: var(--accent-strong);
	}

	:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}
</style>
