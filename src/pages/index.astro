---
import Layout from '../layouts/Layout.astro';
import places from '../data/places.json';
import { CATEGORY_EMOJI, ZONES, PRICE_LABEL, TEMPLE, isTemple, type Place } from '../lib/meta';
import { ORIGINS } from '../lib/travel';

const zones = ZONES.filter((z) => places.some((p) => p.zone === z));
const shops = (places as Place[]).filter((p) => !isTemple(p));
const temples = places.length - shops.length;
const categories = Object.keys(CATEGORY_EMOJI).filter((c) => c !== TEMPLE && places.some((p) => p.category === c));
const quickTags = ['ราคาถูก', 'เปิดดึก', 'แอร์', 'นั่งชิล', 'นั่งทำงานได้', 'ริมคลอง', 'ฮาลาล', 'เดลิเวอรี่'].filter((t) =>
	places.some((p) => p.tags.includes(t)),
);
---

<Layout>
	<header class="top">
		<div class="wrap">
			<p class="eyebrow">สจล. · เกกี · หัวตะเข้ · ลาดกระบัง</p>
			<h1>หิวข้าว<span class="dot">.</span></h1>
			<p class="lede">
				ไม่รู้จะกินอะไร? เลือกโซนกับประเภทที่อยากได้ แล้วกดสุ่ม
				ตอนนี้มีร้านให้สุ่ม <strong>{shops.length}</strong> ร้าน
				{temples > 0 && <> · ถ้าไม่มีงบ เลือก “ฟรี” เพื่อสุ่มจาก <strong>{temples}</strong> วัดได้</>}
			</p>
		</div>
	</header>

	<main class="wrap">
		<section class="machine" aria-labelledby="machine-title">
			<h2 id="machine-title" class="sr-only">สุ่มร้านอาหาร</h2>
			<div class="origin">
				<label for="origin">🧭 เดินทางจาก</label>
				<select id="origin">
					{ORIGINS.map((o) => <option value={o.id}>{o.label}</option>)}
					<option value="gps">📍 ตำแหน่งปัจจุบันของฉัน</option>
				</select>
				<span class="origin-status" id="origin-status" role="status"></span>
			</div>
			<div class="reel" id="reel" aria-hidden="true">
				<span id="reel-text">🍜 วันนี้กินอะไรดี?</span>
			</div>

			<button class="spin" id="spin" type="button">
				<span class="spin-label">สุ่มเลย!</span>
				<span class="spin-count" id="match-count"></span>
			</button>

			<article class="result" id="result" hidden aria-live="polite">
				<div class="result-head">
					<span class="result-emoji" id="r-emoji"></span>
					<div>
						<h3 id="r-name"></h3>
						<p class="result-en" id="r-en"></p>
					</div>
				</div>
				<p class="result-where" id="r-where"></p>
				<dl class="facts">
					<div><dt id="r-cat-label">ประเภท</dt><dd id="r-cat"></dd></div>
					<div><dt>ราคา</dt><dd id="r-price"></dd></div>
					<div><dt>เวลาเปิด</dt><dd id="r-hours"></dd></div>
				</dl>
				<section class="travel" aria-label="ค่าเดินทางโดยประมาณ">
					<div class="travel-head">
						<strong>ค่าเดินทาง</strong>
						<span id="t-dist"></span>
					</div>
					<ul class="quotes" id="t-quotes"></ul>
					<p class="travel-note" id="t-note"></p>
				</section>
				<p class="dishes" id="r-dishes"></p>
				<ul class="tags" id="r-tags"></ul>
				<div class="actions">
					<a class="btn btn-primary" id="r-map" target="_blank" rel="noopener">📍 เปิดแผนที่</a>
					<a class="btn" id="r-dir" target="_blank" rel="noopener">🧭 นำทาง</a>
					<button class="btn" id="r-again" type="button">🎲 สุ่มใหม่</button>
					<button class="btn" id="r-ban" type="button" title="ไม่สุ่มร้านนี้อีกในรอบนี้">🙅 ไม่เอาร้านนี้</button>
				</div>
				<p class="source">
					ข้อมูลจาก <a id="r-source" target="_blank" rel="noopener">แหล่งอ้างอิง</a>
					<span id="r-conf"></span> · ร้านอาจย้ายหรือปิดแล้ว ตรวจสอบก่อนไปนะ
				</p>
			</article>
		</section>

		<section class="filters" aria-labelledby="filter-title">
			<div class="filters-head">
				<h2 id="filter-title">อยากกินแบบไหน</h2>
				<button class="link" id="reset" type="button">ล้างตัวกรอง</button>
			</div>

			<fieldset>
				<legend>โซน</legend>
				<div class="chips" data-group="zone">
					{zones.map((z) => <button type="button" class="chip" data-value={z} aria-pressed="false">{z}</button>)}
				</div>
			</fieldset>

			<fieldset>
				<legend>ประเภท</legend>
				<div class="chips" data-group="category">
					{
						categories.map((c) => (
							<button type="button" class="chip" data-value={c} aria-pressed="false">
								{CATEGORY_EMOJI[c]} {c}
							</button>
						))
					}
				</div>
			</fieldset>

			<fieldset>
				<legend>งบต่อคน</legend>
				<div class="chips" data-group="price">
					{
						Object.entries(PRICE_LABEL).map(([k, v]) => (
							<button type="button" class="chip" data-value={k} aria-pressed="false">
								{v}
							</button>
						))
					}
				</div>
			</fieldset>

			<fieldset>
				<legend>ระยะทาง (จากจุดที่เลือกด้านบน)</legend>
				<div class="chips" data-group="dist" data-single>
					<button type="button" class="chip" data-value="1" aria-pressed="false">🚶 ไม่เกิน 1 กม.</button>
					<button type="button" class="chip" data-value="3" aria-pressed="false">🛵 ไม่เกิน 3 กม.</button>
					<button type="button" class="chip" data-value="7" aria-pressed="false">🚗 ไม่เกิน 7 กม.</button>
				</div>
			</fieldset>

			{
				quickTags.length > 0 && (
					<fieldset>
						<legend>ต้องมี</legend>
						<div class="chips" data-group="tag">
							{quickTags.map((t) => <button type="button" class="chip" data-value={t} aria-pressed="false">{t}</button>)}
						</div>
					</fieldset>
				)
			}
			<p class="hint">ไม่เลือกอะไรเลย = สุ่มจากทุกร้าน · เลือกหลายอันในหมวดเดียวกัน = อันไหนก็ได้</p>
		</section>

		<section class="all" aria-labelledby="all-title">
			<div class="filters-head">
				<h2 id="all-title">รายชื่อทั้งหมด <span class="muted" id="list-count"></span></h2>
			</div>
			<input class="search" id="search" type="search" placeholder="ค้นหาชื่อร้าน เมนู หรือสถานที่…" />
			<ul class="list" id="list"></ul>
			<p class="empty" id="empty" hidden>ไม่มีร้านที่ตรงกับตัวกรอง ลองเอาตัวกรองออกบ้างนะ</p>
		</section>
	</main>

	<footer class="wrap foot">
		<p>
			รวบรวมจาก Wongnai, Google Maps, Pantip, บล็อกรีวิว และเพจของร้าน (อัปเดต ก.ย. 2569) ·
			ราคาและเวลาเปิดเป็นค่าประมาณ
		</p>
	</footer>
</Layout>

<script>
	import places from '../data/places.json';
	import { CATEGORY_EMOJI, PRICE_LABEL, mapsUrl, isTemple, type Place } from '../lib/meta';
	import { ORIGINS, SERVICES, SURGE, roadKm, quote, walkMinutes, type LatLng } from '../lib/travel';

	const all = places as Place[];
	const STORE_KEY = 'hewkhao:filters';
	const ORIGIN_KEY = 'hewkhao:origin';
	type Group = 'zone' | 'category' | 'price' | 'tag' | 'dist';

	const state: Record<Group, Set<string>> = {
		zone: new Set(),
		category: new Set(),
		price: new Set(),
		tag: new Set(),
		dist: new Set(),
	};

	// Places without their own coordinates fall back to the centre of their zone.
	const zoneCentre = new Map<string, LatLng>();
	for (const zone of new Set(all.map((p) => p.zone))) {
		const pts = all.filter((p) => p.zone === zone && p.lat != null && p.lng != null);
		if (pts.length) {
			zoneCentre.set(zone, {
				lat: pts.reduce((a, p) => a + p.lat!, 0) / pts.length,
				lng: pts.reduce((a, p) => a + p.lng!, 0) / pts.length,
			});
		}
	}
	const where = (p: Place): { at: LatLng; exact: boolean } | null =>
		p.lat != null && p.lng != null
			? { at: { lat: p.lat, lng: p.lng }, exact: true }
			: zoneCentre.has(p.zone)
				? { at: zoneCentre.get(p.zone)!, exact: false }
				: null;

	let origin: LatLng & { label: string } = ORIGINS[0];
	let current: Place | null = null;
	const kmCache = new Map<Place, number | null>();
	function kmTo(p: Place) {
		if (!kmCache.has(p)) {
			const w = where(p);
			kmCache.set(p, w ? roadKm(origin, w.at) : null);
		}
		return kmCache.get(p)!;
	}
	const fmtKm = (km: number) => (km < 1 ? `${Math.round(km * 1000 / 50) * 50} ม.` : `${km.toFixed(1)} กม.`);
	const banned = new Set<string>();
	const recent: string[] = [];
	let query = '';
	let spinning = false;

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const keyOf = (p: Place) => `${p.name}|${p.zone}`;

	function matches(p: Place) {
		if (state.zone.size && !state.zone.has(p.zone)) return false;
		if (isTemple(p)) {
			// Temples only join the pool when "free" is chosen; food filters don't apply to them.
			if (!state.price.has('0')) return false;
		} else {
			if (state.category.size && !state.category.has(p.category)) return false;
			if (state.price.size && !state.price.has(String(p.price))) return false;
			for (const t of state.tag) if (!p.tags.includes(t)) return false;
		}
		if (state.dist.size) {
			// Zone-centre fallbacks are too rough for a distance cut-off.
			const km = kmTo(p);
			if (!where(p)?.exact || km == null || km > Math.max(...[...state.dist].map(Number))) return false;
		}
		return true;
	}

	function pool() {
		return all.filter((p) => matches(p) && !banned.has(keyOf(p)));
	}

	function save() {
		try {
			const plain = Object.fromEntries(Object.entries(state).map(([k, v]) => [k, [...v]]));
			localStorage.setItem(STORE_KEY, JSON.stringify(plain));
		} catch {}
	}

	function load() {
		try {
			const raw = localStorage.getItem(STORE_KEY);
			if (!raw) return;
			const saved = JSON.parse(raw) as Partial<Record<Group, string[]>>;
			for (const g of Object.keys(state) as Group[]) {
				for (const v of saved[g] ?? []) state[g].add(v);
			}
		} catch {}
	}

	function syncChips() {
		document.querySelectorAll<HTMLElement>('.chips').forEach((box) => {
			const g = box.dataset.group as Group;
			box.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
				chip.setAttribute('aria-pressed', String(state[g].has(chip.dataset.value!)));
			});
		});
	}

	function refresh() {
		const list = pool();
		const n = list.length;
		const wats = list.filter(isTemple).length;
		const parts = [n - wats && `${n - wats} ร้าน`, wats && `${wats} วัด`].filter(Boolean);
		$('match-count').textContent = n ? `จาก ${parts.join(' + ')}` : 'ไม่มีร้านที่ตรงเงื่อนไข';
		$<HTMLButtonElement>('spin').disabled = n === 0 || spinning;
		renderList();
	}

	function renderList() {
		const q = query.trim().toLowerCase();
		const rows = all.filter((p) => {
			if (!matches(p)) return false;
			if (!q) return true;
			const hay = [p.name, p.nameEn, p.location, p.zone, p.category, ...p.dishes, ...p.tags]
				.filter(Boolean)
				.join(' ')
				.toLowerCase();
			return hay.includes(q);
		});
		$('list-count').textContent = `(${rows.length})`;
		$('empty').hidden = rows.length > 0;
		const list = $('list');
		list.replaceChildren(
			...rows.map((p) => {
				const li = document.createElement('li');
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'row';
				btn.innerHTML = `
					<span class="row-emoji">${CATEGORY_EMOJI[p.category] ?? '🍽️'}</span>
					<span class="row-main">
						<span class="row-name"></span>
						<span class="row-sub"></span>
					</span>
					<span class="row-price">${(PRICE_LABEL[String(p.price)] ?? '').split(' ')[0]}</span>`;
				btn.querySelector('.row-name')!.textContent = p.name;
				const km = kmTo(p);
				const dist = km == null ? '' : `${where(p)!.exact ? '' : '≈'}${fmtKm(km)} · `;
				btn.querySelector('.row-sub')!.textContent = `${dist}${p.zone} · ${p.dishes.slice(0, 3).join(', ') || p.category}`;
				btn.addEventListener('click', () => {
					show(p);
					$('result').scrollIntoView({ behavior: 'smooth', block: 'center' });
				});
				li.append(btn);
				return li;
			}),
		);
	}

	function show(p: Place) {
		$('r-emoji').textContent = CATEGORY_EMOJI[p.category] ?? '🍽️';
		$('r-name').textContent = p.name;
		$('r-en').textContent = p.nameEn ?? '';
		$('r-en').hidden = !p.nameEn;
		$('r-where').textContent = `📌 ${p.zone}${p.location ? ' · ' + p.location : ''}`;
		$('r-cat').textContent = p.category;
		$('r-price').textContent = p.priceText ?? PRICE_LABEL[String(p.price)] ?? '-';
		$('r-hours').textContent = p.hours ?? 'ไม่ระบุ';
		$('r-dishes').textContent = isTemple(p)
			? 'ไปทำบุญ ไหว้พระ หรือช่วยงานวัด · บางวัดมีโรงทานหรือแจกอาหารช่วงวันพระ/งานบุญ แต่ไม่ได้มีทุกวัน ถ้าหิวจริงเตรียมเงินไว้ด้วยนะ'
			: p.dishes.length
				? `เมนูเด็ด: ${p.dishes.join(' · ')}`
				: '';
		$('r-cat-label').textContent = isTemple(p) ? 'สถานที่' : 'ประเภท';
		$('r-tags').replaceChildren(
			...p.tags.map((t) => {
				const li = document.createElement('li');
				li.textContent = t;
				return li;
			}),
		);
		$<HTMLAnchorElement>('r-map').href = mapsUrl(p);
		current = p;
		renderTravel(p);
		const src = $<HTMLAnchorElement>('r-source');
		src.href = p.source;
		try {
			src.textContent = new URL(p.source).hostname.replace(/^www\./, '');
		} catch {
			src.textContent = 'แหล่งอ้างอิง';
		}
		$('r-conf').textContent = p.confidence === 'medium' ? '(ข้อมูลบางส่วนยังไม่ยืนยัน)' : '';
		$('r-ban').dataset.key = keyOf(p);
		const card = $('result');
		card.hidden = false;
		card.classList.remove('pop');
		void card.offsetWidth;
		card.classList.add('pop');
	}

	function renderTravel(p: Place) {
		const w = where(p);
		const km = kmTo(p);
		const dir = $<HTMLAnchorElement>('r-dir');
		const dest = w?.exact ? `${w.at.lat},${w.at.lng}` : p.mapsQuery;
		dir.href = `https://www.google.com/maps/dir/?api=1&origin=${origin.lat},${origin.lng}&destination=${encodeURIComponent(dest)}`;
		if (!w || km == null) {
			$('t-dist').textContent = '';
			$('t-quotes').replaceChildren();
			$('t-note').textContent = 'ร้านนี้ยังไม่มีพิกัด เลยคำนวณค่าเดินทางไม่ได้';
			return;
		}
		$('t-dist').textContent = `${w.exact ? '' : '≈'}${fmtKm(km)} จาก${origin.label}`;
		const rows: HTMLLIElement[] = [];
		const li = (icon: string, label: string, price: string, time: string) => {
			const el = document.createElement('li');
			el.innerHTML = '<span class="q-icon"></span><span class="q-label"></span><span class="q-time"></span><span class="q-price"></span>';
			el.querySelector('.q-icon')!.textContent = icon;
			el.querySelector('.q-label')!.textContent = label;
			el.querySelector('.q-time')!.textContent = time;
			el.querySelector('.q-price')!.textContent = price;
			rows.push(el);
		};
		const mins = (m: number) => `~${Math.max(1, Math.round(m))} นาที`;
		if (km <= 2) li('🚶', 'เดิน', 'ฟรี', mins(walkMinutes(km)));
		for (const s of SERVICES) {
			const q = quote(s, km);
			li(s.id === 'bike' ? '🛵' : '🚗', s.label, q.low === q.high ? `฿${q.low}` : `฿${q.low}–${q.high}`, mins(q.minutes));
		}
		$('t-quotes').replaceChildren(...rows);
		$('t-note').textContent =
			(w.exact ? '' : 'ร้านนี้ไม่มีพิกัดแน่นอน ใช้จุดกลางโซนแทน · ') +
			`ราคาประมาณจากอัตรา Grab ไม่ใช่ราคาจริงในแอป · ช่วงบนเผื่อช่วงเร่งด่วน/ฝนตก (×${SURGE[1]}) ไป-กลับคูณ 2`;
	}

	function setOrigin(o: LatLng & { label: string }) {
		origin = o;
		kmCache.clear();
		if (current) renderTravel(current);
		refresh();
	}

	function useGps() {
		const status = $('origin-status');
		if (!('geolocation' in navigator)) {
			status.textContent = 'เบราว์เซอร์นี้หาตำแหน่งไม่ได้';
			return;
		}
		status.textContent = 'กำลังหาตำแหน่ง…';
		navigator.geolocation.getCurrentPosition(
			(pos) => {
				status.textContent = `แม่นยำ ~${Math.round(pos.coords.accuracy)} ม.`;
				setOrigin({ lat: pos.coords.latitude, lng: pos.coords.longitude, label: 'ตำแหน่งของคุณ' });
			},
			() => {
				status.textContent = 'หาตำแหน่งไม่ได้ (ไม่ได้อนุญาต?) ใช้ สจล. แทน';
				$<HTMLSelectElement>('origin').value = ORIGINS[0].id;
				setOrigin(ORIGINS[0]);
			},
			{ enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
		);
	}

	function pickOrigin(id: string) {
		try {
			localStorage.setItem(ORIGIN_KEY, id);
		} catch {}
		$('origin-status').textContent = '';
		if (id === 'gps') return useGps();
		setOrigin(ORIGINS.find((o) => o.id === id) ?? ORIGINS[0]);
	}

	function pickFrom(list: Place[]) {
		// avoid repeating the last few picks when there is room to
		const fresh = list.filter((p) => !recent.includes(keyOf(p)));
		const src = fresh.length ? fresh : list;
		return src[Math.floor(Math.random() * src.length)];
	}

	function spin() {
		const list = pool();
		if (!list.length || spinning) return;
		spinning = true;
		refresh();
		const winner = pickFrom(list);
		recent.push(keyOf(winner));
		if (recent.length > Math.min(8, Math.floor(list.length / 2))) recent.shift();

		const reel = $('reel');
		const text = $('reel-text');
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const steps = reduce ? 1 : 18;
		let i = 0;
		reel.classList.add('rolling');
		const tick = () => {
			i++;
			const p = i >= steps ? winner : list[Math.floor(Math.random() * list.length)];
			text.textContent = `${CATEGORY_EMOJI[p.category] ?? '🍽️'} ${p.name}`;
			if (i < steps) {
				setTimeout(tick, 40 + i * i * 1.1);
			} else {
				reel.classList.remove('rolling');
				reel.classList.add('landed');
				setTimeout(() => reel.classList.remove('landed'), 600);
				spinning = false;
				show(winner);
				refresh();
			}
		};
		tick();
	}

	document.querySelectorAll<HTMLElement>('.chips').forEach((box) => {
		const g = box.dataset.group as Group;
		box.addEventListener('click', (e) => {
			const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
			if (!chip) return;
			const v = chip.dataset.value!;
			if (state[g].has(v)) state[g].delete(v);
			else {
				if ('single' in box.dataset) state[g].clear();
				state[g].add(v);
			}
			syncChips();
			save();
			refresh();
		});
	});

	$('reset').addEventListener('click', () => {
		Object.values(state).forEach((s) => s.clear());
		banned.clear();
		syncChips();
		save();
		refresh();
	});

	$('spin').addEventListener('click', spin);
	$('r-again').addEventListener('click', spin);
	$('r-ban').addEventListener('click', (e) => {
		const k = (e.currentTarget as HTMLElement).dataset.key;
		if (k) banned.add(k);
		spin();
	});
	$<HTMLInputElement>('search').addEventListener('input', (e) => {
		query = (e.target as HTMLInputElement).value;
		renderList();
	});

	$<HTMLSelectElement>('origin').addEventListener('change', (e) => pickOrigin((e.target as HTMLSelectElement).value));

	load();
	syncChips();
	try {
		const saved = localStorage.getItem(ORIGIN_KEY);
		// Don't trigger a location prompt on page load; GPS must be chosen each visit.
		if (saved && saved !== 'gps' && ORIGINS.some((o) => o.id === saved)) {
			$<HTMLSelectElement>('origin').value = saved;
			origin = ORIGINS.find((o) => o.id === saved)!;
		}
	} catch {}
	refresh();
</script>

