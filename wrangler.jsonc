{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hewkhao",
	"compatibility_date": "2026-09-23",
	// Static site: Worker serves the Astro build output only.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "hewkhao.makufff.dev", "custom_domain": true }],
	"observability": { "enabled": true }
}
